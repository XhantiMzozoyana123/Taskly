# /etc/systemd/system/aivideoworker.service  (copy to /etc/systemd/system/ on the VPS)
#
# Runs AIVideoWorker bare-metal (no Docker) and keeps it alive across shell
# exits and reboots - the native equivalent of docker-compose's
#   restart: unless-stopped  +  container_name: aivideoworker
#
# Create with:
#   sudo cp <repo>/aivideoworker.service /etc/systemd/system/aivideoworker.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now aivideoworker
#   sudo systemctl status aivideoworker
[Unit]
Description=AIVideoWorker (FastAPI image-to-video service, native no-Docker)
After=network.target

[Service]
Type=simple
User=administrator
Group=administrator
WorkingDirectory=/home/administrator/Taskly/Taskly.Python/AIVideoWorker
Environment=PATH=/home/administrator/Taskly/Taskly.Python/AIVideoWorker/.venv/bin
# Export the .env values as the process environment so os.getenv() in
# app/core/config.py picks them up even if load_dotenv() does not.
EnvironmentFile=/home/administrator/Taskly/Taskly.Python/AIVideoWorker/.env
ExecStart=/home/administrator/Taskly/Taskly.Python/AIVideoWorker/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=unless-stopped
RestartSec=5
# Logs go to journald:  journalctl -u aivideoworker -f
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

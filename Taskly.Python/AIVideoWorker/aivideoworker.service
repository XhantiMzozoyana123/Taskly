# /etc/systemd/system/aivideoworker.service  (copy to /etc/systemd/system/ on the VPS)
#
# Runs AIVideoWorker bare-metal (no Docker) and restarts itself on crash /
# reboot - the native equivalent of docker-compose's
#   restart: unless-stopped  +  container_name: aivideoworker
#
# NOTE: systemd has no literal "unless-stopped"; `on-failure` is the closest:
# the service auto-restarts on non-zero exit / crash, but a clean
# `systemctl stop` (like docker stop) is NOT treated as a failure.
#
# Create with:
#   sudo cp <repo>/aivideoworker.service /etc/systemd/system/aivideoworker.service
#   sudo systemctl daemon-reload
#   sudo systemctl restart aivideoworker   # apply this fixed Restart= value
[Unit]
Description=AIVideoWorker (FastAPI image-to-video service, native no-Docker)
After=network.target

[Service]
Type=simple
User=administrator
Group=administrator
WorkingDirectory=/home/administrator/Taskly/Taskly.Python/AIVideoWorker
Environment=PATH=/home/administrator/Taskly/Taskly.Python/AIVideoWorker/.venv/bin
# On 16 GB GPUs (e.g. RTX A4000) the LTX-Video model + VAE sit at ~14.3 GiB and the
# default torch caching allocator fragments the remaining ~1.3 GiB, causing OOM on the
# first ~350 MiB allocation. expandable_segments makes allocations bypass the arena so
# the fragmented "reserved but unallocated" memory becomes usable. Keep this on.
Environment=PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
# Export the .env values as the process environment so os.getenv() in
# app/core/config.py picks them up even if load_dotenv() does not.
EnvironmentFile=/home/administrator/Taskly/Taskly.Python/AIVideoWorker/.env
ExecStart=/home/administrator/Taskly/Taskly.Python/AIVideoWorker/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5
# Logs go to journald:  journalctl -u aivideoworker -f
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

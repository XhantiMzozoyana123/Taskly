{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=Taskly;Trusted_Connection=True"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "App": {
    "Url": "https://localhost:5001"
  },

  "Jwt": {
    "Key": "YourSuperSecretKey12345",
    "Issuer": "Taskly",
    "Audience": "TasklyUsers",
    "ExpiryMinutes": 30
  },

  "EmailSettings": {
    "FromName": "Taskly App",
    "FromEmail": "noreply@taskly.com",
    "Password": "your-email-password",
    "SmtpHost": "smtp.yourprovider.com",
    "SmtpPort": 587,
    "EnableSsl": true
  }
}
